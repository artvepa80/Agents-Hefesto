{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.artvepa80/hefestoai",
  "title": "HefestoAI",
  "description": "Release-truth gate for AI-generated code: local stdio server (MIT) plus a hosted remote.",
  "version": "4.21.1",
  "repository": {
    "url": "https://github.com/artvepa80/Agents-Hefesto",
    "source": "github",
    "id": "1079896229"
  },
  "websiteUrl": "https://hefestoai.narapallc.com",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://hefestoai.narapallc.com/api/mcp-protocol"
    }
  ],
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "hefesto-mcp",
      "version": "4.21.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "HEFESTO_MCP_ROOT",
          "description": "Project directory the tools may read (not / or home)",
          "isRequired": true,
          "isSecret": false
        }
      ]
    }
  ]
}
