# Hefesto Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# CRITICAL SECRETS - NEVER COMMIT THESE
# ============================================

# Stripe Secret Key (REQUIRED for backend/webhooks)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Stripe Webhook Secret (REQUIRED for webhook validation)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# AI PROVIDER (none bundled)
# ============================================

# Hefesto does not bundle an LLM provider and needs no AI API key.
# Optional AI enrichment (PRO) uses a provider you bring, implementing the
# PRO EnrichmentProvider contract; configure its credentials as that
# provider documents.

# ============================================
# GOOGLE CLOUD (OPTIONAL - for BigQuery tracking)
# ============================================

# Google Cloud Project ID
GCP_PROJECT_ID=your-project-id

# Path to service account key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json

# ============================================
# NOTES
# ============================================

# Never commit .env file to git (already in .gitignore)
# Stripe Product IDs and Price IDs are in stripe_config.py (safe to be public)
# Only Secret Keys and Webhook Secrets must be kept private
# Payment Links are public by design (shareable URLs)
